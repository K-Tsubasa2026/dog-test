# LINEでシェアする際に共有するDogTestのURL。
# 未設定の場合はアクセス中のオリジン(window.location.origin)にフォールバックする。
# 開発環境: http://localhost:5173
# 本番環境: 実際にデプロイしたURLに置き換えてください
VITE_APP_URL=http://localhost:5173

# backend(API)の接続先。未設定の場合は開発用のlocalhost:8080にフォールバックする。
# 開発環境: http://localhost:8080
# 本番環境: 実際にデプロイしたbackendのURL(例: EC2のURL)に置き換えてください
VITE_API_BASE_URL=http://localhost:8080
